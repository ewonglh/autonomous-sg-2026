#!/bin/sh
# Fails if a secret is committed. Reads only tracked files (git ls-files).
# Checks: .env.keys tracked; plaintext values in .env; private keys and
# well-known token shapes anywhere. Not a full scanner: turn on GitHub
# secret scanning too (see KICKOFF.md).
cd "$(git rev-parse --show-toplevel)" || exit 1

bad=0
fail() { echo "FAIL  $1"; bad=1; }

# 1. The dotenvx private keys file must never be tracked.
keys=$(git ls-files | grep -E '(^|/)\.env\.keys$')
[ -n "$keys" ] && { echo "$keys" | sed 's/^/FAIL  /; s/$/ is tracked/'; bad=1; }

# 2. In .env files every value must be empty or encrypted (dotenvx format).
for f in $(git ls-files | grep -E '(^|/)\.env(\.[A-Za-z0-9_-]+)?$' | grep -Ev '\.example$|\.keys$'); do
  # KEY=value lines, minus comments, DOTENV_PUBLIC_KEY, empty and encrypted values
  hits=$(tr -d '\r' < "$f" | grep -E '^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=' \
    | grep -Ev '^[[:space:]]*(export[[:space:]]+)?DOTENV_PUBLIC_KEY[A-Za-z0-9_]*=' \
    | grep -Ev '=[[:space:]]*(""|'"''"')?[[:space:]]*(#.*)?$' \
    | grep -Ev '=[[:space:]]*["'"'"']?encrypted:' | sed 's/=.*/=<hidden>/')
  [ -n "$hits" ] && { fail "$f has plaintext values (run: dotenvx encrypt):"; echo "$hits" | sed 's/^/        /'; }
done

# 3. Private keys and well-known token shapes in any tracked text file.
# Prints file and pattern name only, never the matched text.
scan() { # name regex
  out=$(git grep -I -l -E -e "$2" -- . ':!scripts/check-secrets' ':!*.lock' 2>/dev/null)
  [ -n "$out" ] && { echo "$out" | sed "s/^/FAIL  /; s/\$/ looks like it contains $1/"; bad=1; }
}
scan "a private key"          '-----BEGIN [A-Z ]*PRIVATE KEY-----'
scan "an AWS access key"      '(^|[^A-Za-z0-9])AKIA[0-9A-Z]{16}([^A-Za-z0-9]|$)'
scan "a GitHub token"         '(^|[^A-Za-z0-9])gh[pousr]_[A-Za-z0-9]{36,}([^A-Za-z0-9]|$)'
scan "an API key (sk-...)"    '(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{20,}'
scan "a Slack token"          '(^|[^A-Za-z0-9])xox[abprs]-[A-Za-z0-9-]{10,}([^A-Za-z0-9]|$)'

if [ "$bad" -ne 0 ]; then
  echo
  echo "Secret check failed. Remove the value, rotate the secret, and tell the team."
  exit 1
fi
echo "ok  no committed secrets found"
