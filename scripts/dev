#!/bin/sh
# Run the app locally with secrets injected. Each worktree sets its own PORT (issue N uses 3000 + N).
# Start the local FastAPI development server.
set -e

command -v dotenvx >/dev/null 2>&1 || {
  echo "dotenvx is missing. Install: curl -sfS https://dotenvx.sh | sh"
  exit 1
}
[ -f .env.keys ] || echo "warning: .env.keys not found. Ask the team for it."

# Port: use $PORT if set, else 3000 + N when run from a worktree named issue-N-*, else 3000.
if [ -z "$PORT" ]; then
  n=$(basename "$(git rev-parse --show-toplevel)" | sed -n 's/^issue-\([0-9][0-9]*\)-.*/\1/p')
  PORT=$((3000 + ${n:-0}))
fi
export PORT

dotenvx run -- sh scripts/python -m uvicorn src.main:app --host 0.0.0.0 --port "$PORT" --reload
